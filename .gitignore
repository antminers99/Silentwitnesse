# Silent Witness — .gitignore

# compiled output
dist/
build/
tmp/
out-tsc/
*.tsbuildinfo
.vite/
.expo/
.expo-shared/

# dependencies
node_modules/

# environment secrets — never commit
.env
.env.*
!.env.example

# database local files
*.db
*.sqlite
*.sqlite3

# logs
*.log
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# coverage
coverage/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# System Files
.DS_Store
Thumbs.db

# Replit internals — not needed in repo
.cache/
.local/
.agents/
attached_assets/
*.zip
.replit
.replitignore

# NX / Cursor legacy
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
