# Silent Witness — Environment Variable Reference
# Copy this file to .env and fill in the values for local development.
# Never commit .env to version control.

# PostgreSQL connection string.
# In Replit, this is managed automatically.
# For local development: postgres://user:password@localhost:5432/silent_witness
DATABASE_URL=

# Comma-separated list of allowed CORS origins for the API.
# In production, set this to your domain(s).
# Example: https://silentwi.com,https://www.silentwi.com
PUBLIC_APP_ORIGIN=https://silentwi.com

# Session signing secret. Must be a long random string.
SESSION_SECRET=

# Node.js environment. Set to "production" in production.
NODE_ENV=development

# Port for the API server.
# In Replit, this is managed automatically via the PORT env var.
PORT=3000
